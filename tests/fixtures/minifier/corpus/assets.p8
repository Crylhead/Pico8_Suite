pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
-- corpus #148: gfx, map, flags, sfx, music, label and metadata sections around code.
-- self-authored for pico8_suite tests (cc0); data sections reuse the release fixture.
function fbsum()
 local s=0
 for a=0x6000,0x7ffc,4 do
  s^^=$a
  s=s<<>1
 end
 return s
end

function _init()
 flags=fget(1)
 cell=mget(1,0)
 px=sget(8,0)
 music(0)
end

function _update60() end

function _draw()
 cls(1)
 map(0,0,0,0,2,1)
 spr(1,40,40)
 ?"flags "..flags.." cell "..cell.." px "..px,2,60,7
 fb=fbsum()
 -- one console line for original/optimized runtime comparison (#148)
 if not reported then reported=true printh("corpus assets ".."flags="..flags.." cell="..cell.." px="..px.." fb="..tostr(fb,true)) end
end
